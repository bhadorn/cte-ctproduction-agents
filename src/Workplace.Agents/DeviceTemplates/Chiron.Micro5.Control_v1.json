            "AvailableState <= 0 => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "EmergencyStopActive == true => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "ProtectionDoorsOpen == true => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "SpindleWarmupActive == true => OutputMachineState=110; OutputMachineStateName=\"Warmup\"",
            "NCProgramError == true => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "NCProgramRun == true => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "NCProgramStop == true => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "=> OutputMachineState=100; OutputMachineStateName=\"Setup\""
