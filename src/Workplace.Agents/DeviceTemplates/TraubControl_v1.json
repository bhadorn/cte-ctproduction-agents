        {
          "Id": "954f0d9d-88f2-4cbf-8068-ac3a003e942e",
          "Name": "MachineStateProcessor",
          "InitialData": [
            "AvailableState <= 0                          => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "AlarmState == true                           => OutputMachineState=1;   OutputMachineStateName=\"Disturbance\"",
            "OperationMode != 7                           => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == 7 and RunningState == false => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == 7 and RunningState == true and AutoCycle == true and AutomaticStop == true => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == 7 and RunningState == true  => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == 7                           => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\""
          ],
          "Type": "SituationProcessingNode",
          "Ports": [
