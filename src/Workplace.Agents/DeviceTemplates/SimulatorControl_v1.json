          "Name": "MachineStateProcessor",
          "InitialData": [
            "MaintenanceState == 1                    => OutputMachineState=400; OutputMachineStateName=\"Maintenance\"",
            "AvailableState <= 0                      => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "AlarmState != 0                          => OutputMachineState=1;   OutputMachineStateName=\"Disturbance\"",
            "OperationMode != 1 && AfterWorkShift     => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "OperationMode != 1                       => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "JobState >= 300 and JobState <= 399      => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == 1 and RunningState == 3 => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == 1 and RunningState == 2 => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == 1 and RunningState == 1 => OutputMachineState=310; OutputMachineStateName=\"Stopped: Missing Material\"",
            "OperationMode == 1                       => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\""
          ],
