      "Processors": [
        {
          "Id": "f9281b81-66dd-4cde-a71a-7e7df55fecb6",
          "Name": "MachineStateProcessor",
          "InitialData": [
            "MaintenanceState == 1                       => OutputMachineState=400; OutputMachineStateName=\"Maintenance\"",
            "AvailableState != 1 or ConnectionState <= 0 => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "AlarmState != 0                             => OutputMachineState=1;   OutputMachineStateName=\"Disturbance\"",
            "OperationMode != \"AUTOMATIC\"                => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "JobState >= 300 and JobState <= 399         => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == \"AUTOMATIC\" and RunningState == \"ACTIVE\"  => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == \"AUTOMATIC\" and RunningState == \"STOPPED\" => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == \"AUTOMATIC\"                               => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\""
          ],
          "Type": "SituationProcessingNode",
          "Ports": [
            {
              "Name": "AvailableState",
              "DataType": "System.Int32",
              "Public": true,
              "Properties": [
                {
                  "Name": "PortMatchId",
                  "DataType": "System.String",
                  "Value": "AvailableType"
                }
              ]
            },
            {
              "Name": "OutputMachineState",
              "DataType": "System.Int32",
              "FlowDirection": "Output",
              "Public": true,
              "Properties": [
